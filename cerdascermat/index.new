<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Masuk — Dirgahayu Republik Indonesia ke-81</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,600&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --merah:#A61B29;
    --merah-cerah:#E63946;
    --merah-gelap:#6E1220;
    --emas:#D4AF37;
    --emas-terang:#F4CD46;
    --gading:#FFFDF5;
    --ink:#1B1024;
    --navy:#181233;
    --kaca: rgba(255,253,245,0.08);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{height:100%;}
  body{
    font-family:'Poppins',sans-serif;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(230,57,70,0.35), transparent 60%),
      linear-gradient(160deg, var(--navy) 0%, var(--ink) 45%, var(--merah-gelap) 100%);
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    position:relative;
    color:var(--gading);
  }

  /* ---- Motif kawung (batik) prosedural, bukan gambar asli ---- */
  .batik-layer{
    position:fixed; inset:0;
    background-image:
      radial-gradient(circle at 25% 25%, rgba(212,175,55,0.10) 0 6px, transparent 7px),
      radial-gradient(circle at 75% 25%, rgba(212,175,55,0.10) 0 6px, transparent 7px),
      radial-gradient(circle at 25% 75%, rgba(212,175,55,0.10) 0 6px, transparent 7px),
      radial-gradient(circle at 75% 75%, rgba(212,175,55,0.10) 0 6px, transparent 7px);
    background-size:90px 90px;
    opacity:.5;
    pointer-events:none;
  }

  /* ---- Pita bendera bergelombang di puncak halaman ---- */
  .ribbon{
    position:fixed; top:0; left:0; width:200%; height:14px;
    background:repeating-linear-gradient(90deg, var(--gading) 0 60px, var(--merah-cerah) 60px 120px);
    transform:translateY(-2px);
    animation:ribbon-slide 6s linear infinite;
    filter:drop-shadow(0 2px 10px rgba(0,0,0,.35));
    z-index:5;
  }
  @keyframes ribbon-slide{ to{ transform:translateX(-120px) translateY(-2px);} }

  /* ---- Partikel emas mengambang ---- */
  .spark{
    position:fixed; bottom:-10px; border-radius:50%;
    background:radial-gradient(circle, var(--emas-terang), transparent 70%);
    opacity:.75; pointer-events:none;
    animation:float-up linear infinite;
  }
  @keyframes float-up{
    to{ transform:translateY(-110vh) translateX(var(--drift,20px)) rotate(360deg); opacity:0; }
  }

  .eyebrow-year{
    position:fixed;
    top:50%; left:50%; transform:translate(-50%,-50%);
    font-family:'Playfair Display',serif;
    font-size:min(46vw, 620px);
    font-weight:800;
    color:transparent;
    -webkit-text-stroke:1px rgba(212,175,55,0.18);
    letter-spacing:-.02em;
    pointer-events:none;
    user-select:none;
    z-index:0;
  }

  .stage{
    position:relative; z-index:2;
    display:flex; flex-direction:column; align-items:center;
    padding:32px 20px;
    width:100%;
  }

  .kop{
    text-align:center;
    margin-bottom:26px;
    animation:rise .9s cubic-bezier(.2,.8,.2,1) both;
  }
  .kop .eyebrow{
    font-size:12px; letter-spacing:.35em; text-transform:uppercase;
    color:var(--emas-terang); font-weight:600;
    display:flex; align-items:center; justify-content:center; gap:10px;
  }
  .kop .eyebrow::before, .kop .eyebrow::after{
    content:""; width:26px; height:1px; background:var(--emas);
    opacity:.7;
  }
  .kop h1{
    font-family:'Playfair Display',serif;
    font-weight:700;
    font-size:clamp(28px, 4vw, 40px);
    margin-top:10px;
    background:linear-gradient(95deg, var(--gading), var(--emas-terang) 45%, var(--gading));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .kop p.sub{
    margin-top:8px; font-size:13px; color:rgba(255,253,245,0.65); font-weight:300;
    letter-spacing:.04em;
  }

  .card{
    width:min(400px, 92vw);
    background:linear-gradient(180deg, rgba(255,253,245,0.08), rgba(255,253,245,0.03));
    border:1px solid rgba(212,175,55,0.35);
    border-radius:22px;
    padding:38px 32px 30px;
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);
    box-shadow:0 30px 70px -20px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.08);
    position:relative;
    animation:rise 1s .1s cubic-bezier(.2,.8,.2,1) both;
  }
  @keyframes rise{ from{opacity:0; transform:translateY(24px);} to{opacity:1; transform:translateY(0);} }

  /* sudut ornamen emas */
  .card::before, .card::after{
    content:""; position:absolute; width:26px; height:26px;
    border:2px solid var(--emas); opacity:.7;
  }
  .card::before{ top:10px; left:10px; border-right:none; border-bottom:none; border-radius:8px 0 0 0;}
  .card::after{ bottom:10px; right:10px; border-left:none; border-top:none; border-radius:0 0 8px 0;}

  .field{ margin-bottom:20px; }
  .field label{
    display:block; font-size:11px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--emas-terang); margin-bottom:8px; font-weight:500;
  }
  .field input{
    width:100%; padding:13px 4px; font-size:15px; font-family:'Poppins',sans-serif;
    background:transparent; color:var(--gading);
    border:none; border-bottom:1.5px solid rgba(255,253,245,0.28);
    outline:none; transition:border-color .3s ease;
  }
  .field input::placeholder{ color:rgba(255,253,245,0.35); }
  .field input:focus{ border-bottom-color:var(--emas-terang); }

  .error-msg{
    font-size:12.5px; color:#FFD1D1; background:rgba(230,57,70,0.16);
    border:1px solid rgba(230,57,70,0.4); border-radius:10px;
    padding:9px 12px; margin-bottom:16px; display:none; text-align:center;
  }
  .error-msg.show{ display:block; animation:shake .4s ease; }
  @keyframes shake{
    0%,100%{transform:translateX(0);} 20%{transform:translateX(-6px);}
    40%{transform:translateX(6px);} 60%{transform:translateX(-4px);} 80%{transform:translateX(4px);}
  }

  .btn-masuk{
    width:100%; margin-top:6px; padding:15px 0; border:none; border-radius:14px;
    font-family:'Poppins',sans-serif; font-weight:600; font-size:14.5px; letter-spacing:.06em;
    text-transform:uppercase; color:var(--ink); cursor:pointer;
    background:linear-gradient(100deg, var(--emas-terang), var(--emas) 55%, var(--emas-terang));
    background-size:220% 100%;
    background-position:0% 0%;
    position:relative; overflow:hidden;
    box-shadow:0 12px 30px -10px rgba(212,175,55,.65);
    transition:background-position .6s ease, transform .2s ease, box-shadow .2s ease;
  }
  .btn-masuk:hover{ background-position:100% 0%; transform:translateY(-2px); box-shadow:0 16px 34px -8px rgba(212,175,55,.8); }
  .btn-masuk:active{ transform:translateY(0); }
  .btn-masuk .shine{
    position:absolute; top:0; left:-60%; width:40%; height:100%;
    background:linear-gradient(115deg, transparent, rgba(255,255,255,.65), transparent);
    transform:skewX(-20deg);
    animation:shine 2.6s ease-in-out infinite;
  }
  @keyframes shine{ 0%{left:-60%;} 55%{left:130%;} 100%{left:130%;} }

  .btn-masuk.loading{ pointer-events:none; }
  .btn-masuk .label{ position:relative; z-index:2; display:inline-flex; align-items:center; gap:10px; justify-content:center; width:100%;}
  .dot-flow{ display:none; gap:4px; }
  .btn-masuk.loading .txt{ opacity:0; }
  .btn-masuk.loading .dot-flow{ display:inline-flex; position:absolute; }
  .dot-flow span{
    width:6px; height:6px; border-radius:50%; background:var(--ink);
    animation:dotpulse 1s infinite ease-in-out;
  }
  .dot-flow span:nth-child(2){ animation-delay:.15s; }
  .dot-flow span:nth-child(3){ animation-delay:.3s; }
  @keyframes dotpulse{ 0%,80%,100%{transform:scale(.6); opacity:.4;} 40%{transform:scale(1); opacity:1;} }

  .hint{
    text-align:center; margin-top:20px; font-size:11.5px;
    color:rgba(255,253,245,.45); letter-spacing:.02em;
  }

  /* ---- Transisi keluar layar (flash merah-emas) ---- */
  .curtain{
    position:fixed; inset:0; z-index:50;
    background:radial-gradient(circle at 50% 50%, var(--emas-terang), var(--merah-cerah) 55%, var(--ink) 100%);
    clip-path:circle(0% at 50% 65%);
    transition:clip-path .9s cubic-bezier(.65,0,.35,1);
    pointer-events:none;
  }
  .curtain.active{ clip-path:circle(150% at 50% 65%); }
  .curtain-text{
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    font-family:'Playfair Display',serif; color:var(--gading); font-size:22px;
    opacity:0; letter-spacing:.08em; text-align:center; white-space:nowrap;
    transition:opacity .4s ease .5s;
  }
  .curtain.active .curtain-text{ opacity:1; }

  @media (max-width:420px){
    .card{ padding:30px 22px 24px; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.2s !important; }
  }
</style>
</head>
<body>

  <div class="batik-layer"></div>
  <div class="ribbon"></div>
  <div class="eyebrow-year" aria-hidden="true">81</div>
  <div id="sparks"></div>

  <div class="stage">
    <div class="kop">
      <div class="eyebrow">17 Agustus 1945 — 2026</div>
      <h1>Dirgahayu Republik Indonesia</h1>
      <p class="sub">Portal Perayaan Kemerdekaan ke-81 &middot; Silakan masuk untuk melanjutkan</p>
    </div>

    <form class="card" id="loginForm" autocomplete="off">
      <div class="error-msg" id="errorMsg">Nama pengguna atau kata sandi salah. Silakan coba kembali.</div>

      <div class="field">
        <label for="username">Nama Pengguna</label>
        <input type="text" id="username" name="username" placeholder="Masukkan nama pengguna" required>
      </div>

      <div class="field">
        <label for="password">Kata Sandi</label>
        <input type="password" id="password" name="password" placeholder="Masukkan kata sandi" required>
      </div>

      <button type="submit" class="btn-masuk" id="btnMasuk">
        <span class="shine"></span>
        <span class="label">
          <span class="txt">Masuk &amp; Rayakan Merdeka</span>
          <span class="dot-flow"><span></span><span></span><span></span></span>
        </span>
      </button>

      <p class="hint">Merdeka! Satu nusa, satu bangsa, satu bahasa.</p>
    </form>
  </div>

  <div class="curtain" id="curtain">
    <div class="curtain-text">Merdeka! Menyiapkan perayaan untuk Anda…</div>
  </div>

<script>
  // Partikel emas mengambang
  const sparkWrap = document.getElementById('sparks');
  const N = window.innerWidth < 600 ? 14 : 26;
  for(let i=0;i<N;i++){
    const s = document.createElement('div');
    s.className = 'spark';
    const size = 2 + Math.random()*4;
    s.style.width = size+'px';
    s.style.height = size+'px';
    s.style.left = Math.random()*100+'vw';
    s.style.setProperty('--drift', (Math.random()*80-40)+'px');
    s.style.animationDuration = (7 + Math.random()*9)+'s';
    s.style.animationDelay = (Math.random()*10)+'s';
    sparkWrap.appendChild(s);
  }

  const form = document.getElementById('loginForm');
  const btn = document.getElementById('btnMasuk');
  const errorMsg = document.getElementById('errorMsg');
  const curtain = document.getElementById('curtain');

  const VALID_USER = 'joko';
  const VALID_PASS = 'prabowo';

  form.addEventListener('submit', function(e){
    e.preventDefault();
    const user = document.getElementById('username').value.trim();
    const pass = document.getElementById('password').value;

    if(user === VALID_USER && pass === VALID_PASS){
      errorMsg.classList.remove('show');
      btn.classList.add('loading');
      setTimeout(()=>{
        curtain.classList.add('active');
      }, 350);
      setTimeout(()=>{
        window.location.href = 'mulai.html';
      }, 1250);
    } else {
      errorMsg.classList.add('show');
      form.classList.remove('shake');
      void form.offsetWidth;
      document.querySelector('.card').style.animation = 'shake .4s ease';
      setTimeout(()=>{ document.querySelector('.card').style.animation = ''; }, 420);
    }
  });
</script>
</body>
</html>
